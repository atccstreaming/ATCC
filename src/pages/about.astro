---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { getSite } from '../content/site';
import { withBasePath } from '../i18n';

const site = getSite('zh');
---
<BaseLayout title="关于我们">
  <Container class="py-14 sm:py-20">
    <SectionTitle as="h1" eyebrow="ABOUT" title="关于我们" subtitle="认识我们的使命、信仰与领袖。" />

    <div class="mx-auto mt-12 max-w-4xl space-y-10">
      <section class="card p-7">
        <h2 class="font-serif text-2xl text-ink-950">教会生活</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          <img
            src={withBasePath('/images/1449.jpg')}
            alt="教会照片"
            class="aspect-[4/3] w-full rounded-2xl object-cover ring-1 ring-black/10"
            loading="lazy"
          />
          <img
            src={withBasePath('/images/1450.jpg')}
            alt="教会照片"
            class="aspect-[4/3] w-full rounded-2xl object-cover ring-1 ring-black/10"
            loading="lazy"
          />
          <img
            src={withBasePath('/images/pastor.jpg')}
            alt="牧师照片"
            class="aspect-[4/3] w-full rounded-2xl object-cover ring-1 ring-black/10"
            loading="lazy"
          />
        </div>
      </section>

      <section class="card p-7">
        <h2 class="font-serif text-2xl text-ink-950">我们的使命</h2>
        <p class="mt-3 body-text">{site.mission.intro}</p>
        <ul class="mt-5 list-disc space-y-2 pl-5 body-text">
          {site.mission.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
        <p class="mt-5 body-text">{site.mission.closing}</p>
      </section>

      <section class="card p-7">
        <h2 class="font-serif text-2xl text-ink-950">我们的宗旨</h2>
        <p class="mt-3 body-text">{site.purpose.title}</p>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {site.purpose.items.map((it) => (
            <div class="card-inset p-5">
              <div class="font-medium text-ink-950">{it.title}</div>
              <div class="mt-2 body-text">{it.text}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="card p-7">
        <h2 class="font-serif text-2xl text-ink-950">信仰告白</h2>
        <div class="mt-6 space-y-4">
          {site.beliefs.map((b) => (
            <div class="card-inset p-5">
              <div class="font-medium text-ink-950">{b.title}</div>
              <div class="mt-2 body-text">{b.text}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="card p-7">
        <h2 class="font-serif text-2xl text-ink-950">教会领袖</h2>
        <div class="mt-5 flex items-center gap-4">
          <img
            src={withBasePath('/images/pastor.png')}
            alt={`${site.leader.name} 照片`}
            class="h-20 w-20 rounded-3xl object-cover ring-1 ring-black/10"
            loading="lazy"
          />
          <div>
            <div class="font-medium text-ink-950">{site.leader.name}</div>
            <div class="mt-1 text-sm text-ink-900/60">{site.leader.role}</div>
          </div>
        </div>
        <div class="mt-4 space-y-4">
          {site.leader.bio.map((p) => (
            <p class="body-text">{p}</p>
          ))}
        </div>
      </section>
    </div>
  </Container>
</BaseLayout>
