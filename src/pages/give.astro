---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { withBasePath } from '../i18n';
---
<BaseLayout title="奉献" description="支持仁爱三角区华人教会的使命">
  <Container class="py-14 sm:py-20">
    <SectionTitle as="h1" eyebrow="GIVE" title="支持我们的使命" subtitle="谢谢你与我们同工，一同推进福音事工。" />

    <div class="mx-auto mt-12 grid max-w-5xl items-start gap-6 lg:grid-cols-[1fr_20rem]">
      <div class="space-y-6">
        <section class="card p-7">
          <h2 class="font-serif text-2xl text-ink-950">奉献说明</h2>
          <p class="body-text mt-3">您可以通过以下方式使用 Zelle 奉献：</p>
          <ol class="body-text mt-2 list-decimal space-y-1 pl-5">
            <li>打开您的银行 App，找到 Zelle 转账功能</li>
            <li>用银行 App 扫描二维码，或手动输入下方邮箱地址</li>
            <li>输入奉献金额并发送</li>
          </ol>

          <div class="card-inset mt-6 p-5">
            <div class="font-medium text-ink-950">Zelle 收款信息</div>
            <div class="body-text mt-2">
              <div>收款人：<span class="font-medium text-ink-950">AGAPE TRIANGLE CHINESE CHURCH</span></div>
              <div>邮箱：<a href="mailto:ruthzyn@outlook.com" class="link font-medium text-cinnabar-600">ruthzyn@outlook.com</a></div>
            </div>
          </div>

          <p class="body-text mt-5">如有其他奉献方式需求，请联系我们。</p>
          <a href={withBasePath('/contact')} class="btn btn-light btn-sm mt-3">咨询奉献方式</a>
        </section>

        <section class="card p-7">
          <h2 class="font-serif text-2xl text-ink-950">奉献用途</h2>
          <ul class="body-text mt-4 list-disc space-y-1 pl-5">
            <li>本地宣教与福音外展</li>
            <li>主日与团契聚会支持</li>
            <li>关怀与牧养事工</li>
            <li>场地与行政开销</li>
          </ul>
        </section>
      </div>

      <section class="card p-5 text-center lg:sticky lg:top-24">
        <img
          src={withBasePath('/images/zelle.png')}
          alt="Zelle 奉献二维码"
          width="629"
          height="692"
          class="mx-auto w-full max-w-xs rounded-2xl bg-white object-contain p-3 ring-1 ring-black/10"
          loading="lazy"
        />
        <p class="mt-3 text-sm text-ink-900/60">用银行 App 扫码奉献</p>
      </section>
    </div>
  </Container>
</BaseLayout>
