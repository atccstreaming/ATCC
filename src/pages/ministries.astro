---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { withBasePath } from '../i18n';
const ministries = [
  {
    title: '敬拜与诗歌',
    summary: '在敬拜中亲近神、同心颂赞。'
  },
  {
    title: '门训与牧养',
    summary: '以真理建造生命，彼此扶持成长。'
  },
  {
    title: '本地宣教与关怀',
    summary: '扎根三角区华人社区，传扬福音、关怀邻舍。'
  }
];
---
<BaseLayout title="事工" description="教会事工与参与方式">
  <Container class="py-14 sm:py-20">
    <SectionTitle as="h1" eyebrow="MINISTRIES" title="事工" subtitle="一起参与服事，在爱中建造。" />

    <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-3">
      {ministries.map((m) => (
        <article class="card p-7">
          <h2 class="font-serif text-2xl text-ink-950">{m.title}</h2>
          <p class="mt-4 body-text">{m.summary}</p>
        </article>
      ))}
    </div>

    <div class="mx-auto mt-12 max-w-5xl text-center">
      <p class="body-text">想参与服事？欢迎联系我们。</p>
      <a href={withBasePath('/contact')} class="btn btn-dark btn-sm mt-4">联系我们</a>
    </div>
  </Container>
</BaseLayout>
