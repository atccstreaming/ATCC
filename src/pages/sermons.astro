---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { getSundayWorshipByMonth } from '../content/sermons';

const groups = getSundayWorshipByMonth('zh');
---
<BaseLayout title="讲道" description="讲道信息与资源">
  <Container class="py-14 sm:py-20">
    <SectionTitle eyebrow="SERMONS" title="讲道" subtitle="主日崇拜与讲道资源将持续更新。" />

    <div class="mx-auto mt-6 flex max-w-4xl flex-wrap gap-3">
      <a
        href="https://www.youtube.com/@AgapeTriangleChineseChurch"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-cinnabar-500 px-5 py-2.5 text-sm font-medium text-white shadow-soft transition hover:bg-cinnabar-600"
      >
        访问 YouTube 频道
      </a>
    </div>

    <div class="mx-auto mt-12 max-w-4xl">
      <h2 class="font-serif text-3xl text-ink-950">主日崇拜</h2>

      {groups.map((group) => (
        <div class="mt-8 first:mt-6">
          <div class="text-xs font-medium tracking-[0.15em] text-ink-900/40">{group.label}</div>
          <div class="mt-2 divide-y divide-black/10 border-y border-black/10">
            {group.items.map((s) => (
              <div class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <div class="min-w-0 sm:flex sm:items-baseline sm:gap-4">
                  <span class="block shrink-0 text-xs tabular-nums text-ink-900/50 sm:w-16">{s.day}</span>
                  <h3 class="truncate font-serif text-base text-ink-950 sm:text-lg">{s.summary}</h3>
                </div>
                <div class="flex flex-shrink-0 flex-wrap gap-2">
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center rounded-full bg-ink-950 px-3 py-1 text-xs font-medium text-parchment-50 transition hover:bg-ink-900"
                  >
                    完整录像
                  </a>
                  {s.clips.map((clip, i) => (
                    <a
                      href={clip.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={clip.title}
                      class="inline-flex items-center rounded-full border border-black/10 bg-white/40 px-3 py-1 text-xs font-medium text-ink-950 transition hover:bg-white/70"
                    >
                      短片{s.clips.length > 1 ? ` ${i + 1}` : ''}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Container>
</BaseLayout>
