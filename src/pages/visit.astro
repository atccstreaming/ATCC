---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { getSite } from '../content/site';

const site = getSite('zh');
---
<BaseLayout title="聚会信息" description="聚会时间、地点与第一次来访指引">
  <Container class="py-14 sm:py-20">
    <SectionTitle as="h1" eyebrow="VISIT" title="欢迎参加我们的每周聚会" subtitle="我们期待与你相见。" />

    <div class="mx-auto mt-12 grid max-w-5xl gap-6 lg:grid-cols-2">
      <section class="card p-7">
        <h2 class="font-serif text-2xl text-ink-950">聚会时间</h2>
        <div class="mt-5 space-y-3">
          {site.weeklyMeetings.map((m) => (
            <div class="card-inset p-5">
              <div class="font-medium text-ink-950">{m.title}</div>
              <div class="mt-2 text-base text-ink-900/80">{m.time}</div>
            </div>
          ))}
        </div>
        <div class="mt-5 card-inset p-5 text-base leading-8 text-ink-900/80">
          <div class="font-medium text-ink-950">第一次来访小贴士</div>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>建议提前 10 分钟到达，方便问询与入座。</li>
            <li>如需代祷或关怀，请在聚会后与同工联系。</li>
            <li>欢迎带朋友与家人一同参加。</li>
          </ul>
        </div>
      </section>

      <section class="card p-7">
        <h2 class="font-serif text-2xl text-ink-950">地点与联系</h2>
        <div class="mt-5 space-y-3 body-text">
          <div>
            <div class="font-medium text-ink-950">地址</div>
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-1 block link">{site.addressFull}</a>
          </div>
          <div>
            <div class="font-medium text-ink-950">电话</div>
            <a class="link" href={site.phoneHref}>{site.phoneDisplay}</a>
          </div>
          <div>
            <div class="font-medium text-ink-950">邮箱</div>
            <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-dark btn-sm">打开地图</a>
          <a href={site.phoneHref} class="btn btn-light btn-sm">拨打电话</a>
        </div>
      </section>
    </div>
  </Container>
</BaseLayout>
