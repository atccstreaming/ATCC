---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { withBasePath } from '../../i18n';

const ministries = [
  {
    title: 'Worship & Music',
    summary: 'Draw near to God and worship together.'
  },
  {
    title: 'Discipleship & Care',
    summary: 'Build lives with truth and walk together in love.'
  },
  {
    title: 'Local Mission & Outreach',
    summary: 'Serve the local Chinese community and share the gospel.'
  }
];
---
<BaseLayout title="Ministries" description="Ministries and how to get involved">
  <Container class="py-14 sm:py-20">
    <SectionTitle as="h1" eyebrow="MINISTRIES" title="Ministries" subtitle="Serve together and grow in love." />

    <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-3">
      {ministries.map((m) => (
        <article class="card p-7">
          <h2 class="font-serif text-2xl text-ink-950">{m.title}</h2>
          <p class="mt-4 body-text">{m.summary}</p>
        </article>
      ))}
    </div>

    <div class="mx-auto mt-12 max-w-5xl text-center">
      <p class="body-text">Interested in serving? We’d love to hear from you.</p>
      <a href={withBasePath('/en/contact')} class="btn btn-dark btn-sm mt-4">Contact us</a>
    </div>
  </Container>
</BaseLayout>
