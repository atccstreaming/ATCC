---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { withBasePath } from '../../i18n';
---
<BaseLayout title="Give" description="Support our mission in the Triangle">
  <Container class="py-14 sm:py-20">
    <SectionTitle as="h1" eyebrow="GIVE" title="Support our mission" subtitle="Thank you for partnering with us in gospel ministry." />

    <div class="mx-auto mt-12 grid max-w-5xl items-start gap-6 lg:grid-cols-[1fr_20rem]">
      <div class="space-y-6">
        <section class="card p-7">
          <h2 class="font-serif text-2xl text-ink-950">Giving</h2>
          <p class="body-text mt-3">How to give via Zelle:</p>
          <ol class="body-text mt-2 list-decimal space-y-1 pl-5">
            <li>Open your banking app and find the Zelle transfer feature</li>
            <li>Scan the QR code, or manually enter the email address below</li>
            <li>Enter your donation amount and send</li>
          </ol>

          <div class="card-inset mt-6 p-5">
            <div class="font-medium text-ink-950">Zelle Recipient Info</div>
            <div class="body-text mt-2">
              <div>Name: <span class="font-medium text-ink-950">AGAPE TRIANGLE CHINESE CHURCH</span></div>
              <div>Email: <a href="mailto:ruthzyn@outlook.com" class="link font-medium text-cinnabar-600">ruthzyn@outlook.com</a></div>
            </div>
          </div>

          <p class="body-text mt-5">For other giving options, please contact us.</p>
          <a href={withBasePath('/en/contact')} class="btn btn-light btn-sm mt-3">Ask about giving</a>
        </section>

        <section class="card p-7">
          <h2 class="font-serif text-2xl text-ink-950">How gifts are used</h2>
          <ul class="body-text mt-4 list-disc space-y-1 pl-5">
            <li>Local mission and outreach</li>
            <li>Sunday services and fellowship</li>
            <li>Care and shepherding</li>
            <li>Facility and operations</li>
          </ul>
        </section>
      </div>

      <section class="card p-5 text-center lg:sticky lg:top-24">
        <img
          src={withBasePath('/images/zelle.png')}
          alt="Zelle giving QR code"
          width="629"
          height="692"
          class="mx-auto w-full max-w-xs rounded-2xl bg-white object-contain p-3 ring-1 ring-black/10"
          loading="lazy"
        />
        <p class="mt-3 text-sm text-ink-900/60">Scan with your banking app to give</p>
      </section>
    </div>
  </Container>
</BaseLayout>
