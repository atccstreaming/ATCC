---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getSite } from '../../content/site';

const site = getSite('en');
---
<BaseLayout title="Visit" description="Service times, location, and what to expect">
  <Container class="py-14 sm:py-20">
    <SectionTitle as="h1" eyebrow="VISIT" title="Plan a Visit" subtitle="We would love to meet you." />

    <div class="mx-auto mt-12 grid max-w-5xl gap-6 lg:grid-cols-2">
      <section class="card p-7">
        <h2 class="font-serif text-2xl text-ink-950">Service Times</h2>
        <div class="mt-5 space-y-3">
          {site.weeklyMeetings.map((m) => (
            <div class="card-inset p-5">
              <div class="font-medium text-ink-950">{m.title}</div>
              <div class="mt-2 text-base text-ink-900/80">{m.time}</div>
            </div>
          ))}
        </div>
        <div class="mt-5 card-inset p-5 text-base leading-8 text-ink-900/80">
          <div class="font-medium text-ink-950">What to Expect</div>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>Arrive about 10 minutes early to get settled.</li>
            <li>If you need prayer or care, please talk to a church volunteer after service.</li>
            <li>Feel free to invite friends and family.</li>
          </ul>
        </div>
      </section>

      <section class="card p-7">
        <h2 class="font-serif text-2xl text-ink-950">Location & Contact</h2>
        <div class="mt-5 space-y-3 body-text">
          <div>
            <div class="font-medium text-ink-950">Address</div>
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-1 block link">{site.addressFull}</a>
          </div>
          <div>
            <div class="font-medium text-ink-950">Phone</div>
            <a class="link" href={site.phoneHref}>{site.phoneDisplay}</a>
          </div>
          <div>
            <div class="font-medium text-ink-950">Email</div>
            <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-dark btn-sm">Get directions</a>
          <a href={site.phoneHref} class="btn btn-light btn-sm">Call us</a>
        </div>
      </section>
    </div>
  </Container>
</BaseLayout>
