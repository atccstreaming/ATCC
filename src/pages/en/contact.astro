---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getSite } from '../../content/site';

const site = getSite('en');
---
<BaseLayout title="Contact" description="Contact Agape Triangle Chinese Church">
  <Container class="py-14 sm:py-20">
    <SectionTitle as="h1" eyebrow="CONTACT" title="Contact" subtitle="We welcome questions and prayer needs." />

    <div class="mx-auto mt-8 grid max-w-2xl gap-6">
      <section class="card p-6">
        <h2 class="font-serif text-2xl text-ink-950">Church Info</h2>
        <div class="mt-5 space-y-4 body-text">
          <div>
            <div class="font-medium text-ink-950">Address</div>
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-1 block link">{site.addressFull}</a>
          </div>
          <div>
            <div class="font-medium text-ink-950">Email</div>
            <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div>
            <div class="font-medium text-ink-950">Phone</div>
            <a class="link" href={site.phoneHref}>{site.phoneDisplay}</a>
          </div>
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-dark">Open Map</a>
          <a href={site.phoneHref} class="btn btn-light">Call</a>
          <a href={`mailto:${site.email}`} class="btn btn-light">Email</a>
        </div>
      </section>
    </div>
  </Container>
</BaseLayout>
