---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getSite } from '../../content/site';
import { getSundayWorship } from '../../content/sermons';
import { withBasePath } from '../../i18n';

const site = getSite('en');
const latest = getSundayWorship('en')[0];
---
<BaseLayout>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(31,138,112,0.14),transparent_55%),radial-gradient(circle_at_bottom,rgba(226,61,40,0.10),transparent_60%)] [mask-image:linear-gradient(to_bottom,#000_65%,transparent)]"></div>
    <Container class="relative py-14 sm:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white/60 px-3 py-1 text-xs text-ink-900/70">
            <span class="h-2 w-2 rounded-full bg-jade-500"></span>
            Join our weekly gatherings
          </div>
          <h1 class="mt-6 text-balance font-serif text-4xl leading-tight tracking-wide text-ink-950 sm:text-5xl sm:leading-[1.12]">
            Welcome to {site.nameEn}
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-8 text-ink-900/80">
            {site.description}
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={withBasePath('/en/visit')} class="btn btn-dark">Plan a Visit</a>
            <a href={withBasePath('/en/contact')} class="btn btn-light">Contact</a>
          </div>
        </div>

        <div class="card p-6 backdrop-blur sm:p-7">
          <div class="flex items-center justify-between">
            <h2 class="font-serif text-xl text-ink-950">Weekly Gatherings</h2>
            <div class="text-xs text-ink-900/60">Raleigh, NC</div>
          </div>
          <div class="mt-4 space-y-3">
            {site.weeklyMeetings.map((m) => (
              <div class="card-inset px-4 py-3">
                <div class="font-medium text-ink-950">{m.title}</div>
                <div class="mt-1 text-sm text-ink-900/70">{m.time}</div>
              </div>
            ))}
          </div>
          <div class="card-inset mt-3 flex items-start justify-between gap-4 px-4 py-3">
            <div>
              <div class="font-medium text-ink-950">Address</div>
              <div class="mt-1 text-sm text-ink-900/70">{site.addressLines.join(' ')}</div>
            </div>
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="link mt-0.5 shrink-0 whitespace-nowrap text-sm text-cinnabar-600">View map</a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  {latest && (
    <section class="pb-4 pt-2 sm:pt-6">
      <Container>
        <div class="card mx-auto max-w-5xl p-6 sm:p-8">
          <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div class="min-w-0">
              <div class="eyebrow">LATEST SERMON</div>
              <h2 class="mt-2 font-serif text-2xl text-ink-950 sm:text-3xl">Latest Sunday Worship</h2>
              <div class="mt-2 text-sm text-ink-900/60">{latest.dateLabel}</div>
              <p class="mt-3 font-serif text-xl leading-8 text-ink-950">{latest.summary}</p>
            </div>
            <div class="flex shrink-0 flex-col gap-3 sm:flex-row md:flex-col lg:flex-row">
              <a href={latest.url} target="_blank" rel="noopener noreferrer" class="btn btn-dark">Watch full service</a>
              {latest.clips[0] && (
                <a href={latest.clips[0].url} target="_blank" rel="noopener noreferrer" class="btn btn-light">Watch highlights</a>
              )}
              <a href={withBasePath('/en/sermons')} class="btn btn-light">All sermons</a>
            </div>
          </div>
        </div>
      </Container>
    </section>
  )}

  <section class="py-14 sm:py-20">
    <Container>
      <SectionTitle eyebrow="MISSION" title="Our Mission" />

      <div class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-3">
        {site.mission.bullets.map((b, i) => (
          <div class="card p-7">
            <div class="font-serif text-3xl text-jade-600/80">{String(i + 1).padStart(2, '0')}</div>
            <p class="body-text mt-3">{b}</p>
          </div>
        ))}
      </div>

      <p class="mx-auto mt-8 max-w-3xl text-center font-serif text-lg leading-8 text-ink-900/80">
        {site.mission.closing}
      </p>
    </Container>
  </section>

  <section class="py-14 sm:py-20">
    <Container>
      <SectionTitle eyebrow="LEADERSHIP" title="Leadership" subtitle="Get to know our pastor and team." />

      <div class="card mx-auto mt-10 grid max-w-5xl items-start gap-6 p-7 sm:p-9 md:grid-cols-[auto_1fr] md:gap-9">
        <div class="flex items-center gap-5 md:block">
          <img
            src={withBasePath('/images/pastor.png')}
            alt={`${site.leader.name} photo`}
            width="239"
            height="300"
            class="h-28 w-24 rounded-2xl object-cover ring-1 ring-black/10 md:h-48 md:w-40"
            loading="lazy"
          />
          <div class="md:mt-5">
            <div class="font-serif text-2xl text-ink-950">{site.leader.name}</div>
            <div class="mt-1 text-sm text-ink-900/60">{site.leader.role}</div>
          </div>
        </div>
        <div>
          <p class="body-text">{site.leader.bio[0]}</p>
          <a href={withBasePath('/en/about')} class="btn btn-accent btn-sm mt-6">Read more</a>
        </div>
      </div>
    </Container>
  </section>

  <section class="pb-6 pt-4 sm:pt-8">
    <Container>
      <div class="mx-auto max-w-5xl rounded-3xl bg-jade-600 p-8 text-white shadow-soft sm:p-12">
        <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
          <div>
            <div class="text-xs font-medium tracking-[0.2em] text-white/90">NEXT STEP</div>
            <h2 class="mt-2 font-serif text-3xl tracking-wide">New here? We’d love to meet you.</h2>
            <p class="mt-3 text-base leading-8 text-white/95">
              Find our gathering times, our location, and tips for your first visit.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href={withBasePath('/en/visit')} class="btn bg-white text-ink-950 hover:bg-parchment-50">Plan a Visit</a>
            <a href={withBasePath('/en/contact')} class="btn border border-white/40 text-white hover:bg-white/10">Contact</a>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
