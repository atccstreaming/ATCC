---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { withBasePath } from '../i18n';
---
<BaseLayout title="找不到页面 · Page not found" noindex>
  <Container class="py-20 sm:py-28">
    <div class="mx-auto max-w-xl text-center">
      <div class="eyebrow">404</div>
      <h1 class="mt-3 font-serif text-3xl text-ink-950 sm:text-4xl">找不到这个页面</h1>
      <p class="body-text mt-4">您要找的页面不存在，或已被移动。</p>
      <h2 class="mt-8 font-serif text-2xl text-ink-950">Page not found</h2>
      <p class="body-text mt-3">The page you’re looking for doesn’t exist or may have moved.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={withBasePath('/')} class="btn btn-dark">返回首页</a>
        <a href={withBasePath('/en')} class="btn btn-light">Back to home</a>
      </div>
    </div>
  </Container>
</BaseLayout>
