---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite } from '../content/site';
import { getLocaleFromPathname, withBasePath, withLocale, type Locale } from '../i18n';

const { title, description, noindex = false } = Astro.props;
const locale: Locale = getLocaleFromPathname(Astro.url.pathname);
const site = getSite(locale);
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.nameEn}`;
const pageDescription = description ?? site.description;
const canonical = Astro.url;
const origin = Astro.site ?? Astro.url;
const baseUrl = (import.meta as any).env?.BASE_URL ?? '/';
const backgroundUrl = withBasePath('/images/background.webp');
const abs = (path: string) => new URL(withBasePath(path), origin).toString();
const socialImage = abs('/og-image.png');

// Page-for-page language alternates, so search engines serve the right language.
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const zhUrl = abs(withSlash(withLocale(Astro.url.pathname, 'zh')));
const enUrl = abs(withSlash(withLocale(Astro.url.pathname, 'en')));

// Structured data: lets search engines show address, phone and service times.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: site.nameEn,
  alternateName: site.name,
  url: abs('/'),
  logo: abs('/logo.png'),
  image: socialImage,
  description: site.description,
  telephone: site.phoneE164,
  email: site.email,
  sameAs: [site.youtubeUrl],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '8509 Penny Rd',
    addressLocality: 'Raleigh',
    addressRegion: 'NC',
    postalCode: '27606',
    addressCountry: 'US'
  },
  knowsLanguage: ['zh', 'en'],
  openingHoursSpecification: site.weeklyMeetings.map((m) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: m.day,
    opens: m.opens,
    closes: m.closes
  }))
};
---
<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-Hans'} style={`--base-url: ${baseUrl}; --bg-image: url('${backgroundUrl}');`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101828" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && (
      <>
        <link rel="canonical" href={canonical.toString()} />
        <link rel="alternate" hreflang="zh-Hans" href={zhUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={zhUrl} />
      </>
    )}
    <meta property="og:site_name" content={`${site.name} · ${site.nameEn}`} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} · ${site.nameEn}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href={withBasePath('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBasePath('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={withBasePath('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBasePath('/site.webmanifest')} />
    <link rel="preload" as="image" href={backgroundUrl} type="image/webp" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-ink-950 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-parchment-50"
    >
      {locale === 'en' ? 'Skip to main content' : '跳到主要内容'}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
