---
import Container from './Container.astro';
import { getSite } from '../content/site';
import { getLocaleFromPathname, stripBasePath, withBasePath, withLocale, type Locale } from '../i18n';

const current = Astro.url.pathname;
const locale: Locale = getLocaleFromPathname(current);
const site = getSite(locale);

// Built pages end in a slash ("/about/"), nav hrefs don't — compare without it.
const trimSlash = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const currentPath = trimSlash(stripBasePath(current));

const nav =
  locale === 'en'
    ? [
        { href: '/en', label: 'Home' },
        { href: '/en/about', label: 'About' },
        { href: '/en/visit', label: 'Visit' },
        { href: '/en/sermons', label: 'Sermons' },
        { href: '/en/events', label: 'Events' },
        { href: '/en/ministries', label: 'Ministries' },
        { href: '/en/give', label: 'Give' },
        { href: '/en/contact', label: 'Contact' }
      ]
    : [
        { href: '/', label: '首页' },
        { href: '/about', label: '关于我们' },
        { href: '/visit', label: '聚会信息' },
        { href: '/sermons', label: '讲道' },
        { href: '/events', label: '活动' },
        { href: '/ministries', label: '事工' },
        { href: '/give', label: '奉献' },
        { href: '/contact', label: '联系' }
      ];

const switchTo = locale === 'en' ? 'zh' : 'en';
// The 404 page has no translated twin, so its language toggle goes to the other home page.
const isNotFound = trimSlash(currentPath).replace(/\.html$/, '') === '/404';
const switchHref = isNotFound ? (switchTo === 'en' ? '/en' : '/') : withLocale(current, switchTo);
const switchLabel = locale === 'en' ? '中文' : 'EN';
const switchAria = locale === 'en' ? '切换到中文' : 'Switch to English';
const visitHref = locale === 'en' ? '/en/visit' : '/visit';
const visitLabel = locale === 'en' ? 'Plan a Visit' : '欢迎来访';
const en = locale === 'en';
---
<header class="sticky top-0 z-50 border-b border-black/5 bg-parchment-50/90 backdrop-blur">
  <Container class="py-3">
    <div class="flex items-center justify-between gap-3">
      <a href={withBasePath(locale === 'en' ? '/en' : '/')} class="flex min-w-0 items-center gap-2.5">
        <img src={withBasePath('/logo.png')} alt="" width="40" height="37" class="h-9 w-auto shrink-0" />
        {en ? (
          <span class="max-w-[10.5rem] font-serif text-base leading-tight text-ink-950 sm:max-w-none sm:whitespace-nowrap sm:text-lg">{site.nameEn}</span>
        ) : (
          <>
            <span class="whitespace-nowrap font-serif text-lg tracking-wide text-ink-950">{site.name}</span>
            <span class="hidden whitespace-nowrap text-xs text-ink-800/70 xl:inline">{site.nameEn}</span>
          </>
        )}
      </a>

      <nav class:list={['hidden items-center gap-0.5', en ? 'xl:flex' : 'lg:flex']} aria-label={en ? 'Main' : '主导航'}>
        {nav.map((item) => {
          const active = currentPath === item.href;
          return (
            <a
              href={withBasePath(item.href)}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-2 text-sm transition',
                active
                  ? 'bg-ink-950 text-parchment-50 shadow-soft'
                  : 'text-ink-900/80 hover:bg-black/5 hover:text-ink-950'
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="flex shrink-0 items-center gap-2">
        <a
          href={withBasePath(switchHref)}
          lang={switchTo === 'en' ? 'en' : 'zh-Hans'}
          hreflang={switchTo === 'en' ? 'en' : 'zh-Hans'}
          class="btn btn-light btn-sm"
          aria-label={switchAria}
        >
          {switchLabel}
        </a>

        <a href={withBasePath(visitHref)} class="btn btn-accent btn-sm hidden whitespace-nowrap sm:inline-flex">
          {visitLabel}
        </a>

        <details class:list={['relative', en ? 'xl:hidden' : 'lg:hidden']} data-mobile-menu>
          <summary
            class="btn btn-light btn-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden"
            aria-label={locale === 'en' ? 'Open menu' : '打开菜单'}
          >
            {locale === 'en' ? 'Menu' : '菜单'}
          </summary>
          <div class="absolute right-0 mt-2 w-56 max-w-[calc(100vw-2rem)] overflow-hidden rounded-2xl border border-black/10 bg-white/95 shadow-soft backdrop-blur">
            <nav class="flex flex-col p-2" aria-label={locale === 'en' ? 'Menu' : '菜单'}>
              {nav.map((item) => {
                const active = currentPath === item.href;
                return (
                  <a
                    href={withBasePath(item.href)}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'rounded-xl px-3 py-2.5 text-sm transition',
                      active ? 'bg-ink-950 text-parchment-50' : 'text-ink-900/80 hover:bg-black/5 hover:text-ink-950'
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })}
              <div class="my-1 border-t border-black/10"></div>
              <a href={withBasePath(visitHref)} class="btn btn-accent btn-sm mt-1">{visitLabel}</a>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </Container>
</header>

<script is:inline>
  (() => {
    const details = document.querySelector('details[data-mobile-menu]');
    if (!details) return;

    const close = () => details.removeAttribute('open');

    document.addEventListener('click', (e) => {
      if (!details.hasAttribute('open')) return;
      const target = e.target;
      if (!(target instanceof Node)) return;
      if (!details.contains(target)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!details.hasAttribute('open')) return;
      if (e.key === 'Escape') close();
    });

    details.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      if (target.closest('a')) close();
    });
  })();
</script>
